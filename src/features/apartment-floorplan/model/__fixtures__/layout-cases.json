{
  "_comment": "Ca kiểm thử chuẩn hoá layout dùng chung: renderer, frontend, mobile và backend phải cho cùng kết quả. input -> expected.",
  "cases": [
    {
      "name": "legacy layout keeps its shape",
      "input": {
        "items": {
          "sofa-1": { "x": 1.23456, "z": 2, "rot": 9.42477796, "hidden": true }
        },
        "extras": [
          { "id": "extra-1", "kind": "chair", "x": 2, "z": 3, "rot": 0 }
        ]
      },
      "expected": {
        "items": {
          "sofa-1": { "x": 1.235, "z": 2, "rot": 3.1416, "hidden": true }
        },
        "extras": [
          { "id": "extra-1", "kind": "chair", "x": 2, "z": 3, "rot": 0 }
        ]
      }
    },
    {
      "name": "empty and junk inputs",
      "input": null,
      "expected": { "items": {}, "extras": [] }
    },
    {
      "name": "room overrides keep only known materials and trimmed names",
